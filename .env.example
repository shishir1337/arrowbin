# Copy to .env.local and fill in to enable real lead emails via Resend.
# Without these, the contact form still works in dev — leads are logged to the
# server console and the form returns success (no email is sent).

# Get a free API key at https://resend.com/api-keys
RESEND_API_KEY=

# The "from" address. Must be a verified domain in Resend, e.g.
# "Arrowbin Website <hello@arrowbin.com>". Defaults to Resend's onboarding sender.
CONTACT_FROM_EMAIL=

# --- Analytics & Search Console (optional) ---
# Google Analytics 4 measurement ID, e.g. "G-XXXXXXXXXX". When set, gtag.js loads
# and a `generate_lead` event fires on each successful contact-form submission.
# Must be NEXT_PUBLIC_ (used in the browser).
NEXT_PUBLIC_GA_ID=G-ZZ3NJCZVMZ

# Microsoft Clarity project ID (Settings > Overview in Clarity). Loads in production
# builds for heatmaps and session recordings; layout.tsx falls back to this one.
NEXT_PUBLIC_CLARITY_ID=yyrhxyezh5

# Google Search Console verification token (the content value of the
# `google-site-verification` meta tag). Renders the verification <meta> in <head>.
GOOGLE_SITE_VERIFICATION=

# --- Database (Neon Postgres) ---
# Written by `neon deploy` / `neon env pull`. DATABASE_URL is the pooled endpoint
# the app queries; DATABASE_URL_UNPOOLED is the direct one `pnpm db:migrate`
# uses for schema changes. Without DATABASE_URL the blog shows only the posts
# in src/lib/posts and the RankYak webhook answers 500.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- RankYak blog webhook (src/app/api/rankyak-webhook) ---
# Must equal the secret RankYak sends in the X-RankYak-Secret header.
RANKYAK_WEBHOOK_SECRET=

# Optional: lets the webhook drop changed pages from Cloudflare's edge cache
# (the "Cache pages at the edge" rule keeps them up to 2 hours). Zone ID from
# the arrowbin.com overview page; an API token limited to Zone > Cache Purge.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
